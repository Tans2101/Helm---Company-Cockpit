{
  "name": "Helm — CEO Operating System",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && .venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001 --reload",
      "description": "FastAPI backend API on http://localhost:8001 (health: /api/health)"
    },
    {
      "name": "frontend",
      "command": "cd frontend && yarn start",
      "description": "React (CRA/craco) dev server on http://localhost:3000, proxies /api to the backend"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 3000 },
    { "name": "backend", "port": 8001 }
  ]
}
