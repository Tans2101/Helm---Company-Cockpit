# MongoDB Atlas (required for production — do not use ephemeral/local-only DB)
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=helm

# Session & security
SESSION_SECRET=change-me-to-a-long-random-string
OAUTH_STATE_SECRET=change-me-oauth-state
COOKIE_SECURE=true
# Use "none" when frontend (Vercel) and API (Render) are different sites without a rewrite proxy.
# Use "lax" when Vercel rewrites /api → Render (same-origin cookies).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=helmcontrol.online

# App URLs (production)
FRONTEND_URL=https://www.helmcontrol.online
APP_URL=https://www.helmcontrol.online
CORS_ORIGINS=https://www.helmcontrol.online,https://helmcontrol.online
# Optional regex for preview hosts (never use ".*" in production)
# CORS_ORIGIN_REGEX=https://.*\.emergentagent\.com

# Feature flags (production)
ALLOW_DEMO_LOGIN=false
DEMO_RESET_ENABLED=false

# AI — direct Anthropic (not Emergent)
# API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model ID — use a current Sonnet string from https://docs.anthropic.com/en/docs/about-claude/models/overview
ANTHROPIC_MODEL=claude-sonnet-5

# Clerk (recommended for sign-in — replaces Google OAuth for login)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://clerk.helmcontrol.online/.well-known/jwks.json
# CLERK_PUBLISHABLE_KEY=pk_live_...  # optional — derived from JWKS when unset
CLERK_PRIMARY_ORIGIN=https://www.helmcontrol.online
SETUP_SECRET=change-me-for-local-setup-endpoint

# Google OAuth (login fallback if Clerk is not set; also used for Calendar/Gmail integrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# QuickBooks OAuth (optional)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox

# Email (Resend)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# Paddle Billing
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=production

# Pricing
PRO_PRICE=8

# Cloudflare R2 — private document storage for bill/receipt uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Document upload/extract rate limits (per workspace, rolling 1-hour window via Mongo TTL)
DOC_UPLOAD_HOURLY_LIMIT=30
# DOC_EXTRACT_HOURLY_LIMIT=30

# Abandoned uploads (never committed to a financial entry) — cleaned by /api/admin/cleanup-orphaned-documents
DOC_ORPHAN_RETENTION_DAYS=7

# --- Integrations quick reference (see /INTEGRATIONS.md) ---
# Google Calendar OAuth → Calendar + briefing context
# QuickBooks OAuth → Financials sync (/api/integrations/quickbooks/sync)
# ANTHROPIC_API_KEY → briefing, Ask Helm, bill extraction
# R2_* → document upload on Financials
# RESEND_API_KEY → team invite emails
# PADDLE_* → billing when BILLING_ENFORCED=true
