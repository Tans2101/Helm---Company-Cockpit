# MongoDB Atlas (required for production — do not use ephemeral/local-only DB)
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=helm

# Session & security
SESSION_SECRET=change-me-to-a-long-random-string
OAUTH_STATE_SECRET=change-me-oauth-state
COOKIE_SECURE=true
# Use "none" when frontend (Vercel) and API (Render) are different sites without a rewrite proxy.
# Use "lax" when Vercel rewrites /api → Render (same-origin cookies).
COOKIE_SAMESITE=none

# App URLs (your real domains)
FRONTEND_URL=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# Feature flags (production)
ALLOW_DEMO_LOGIN=false
DEMO_RESET_ENABLED=false

# AI — direct Anthropic (not Emergent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google OAuth (Google Cloud Console → OAuth client)
# Authorized redirect URI must be exactly:
#   https://YOUR-RENDER-SERVICE.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# QuickBooks OAuth (optional)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox

# Email (Resend)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# Paddle Billing
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=production

# Pricing
PRO_PRICE=8
